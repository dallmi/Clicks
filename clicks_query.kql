// ============================================================================
// Clicks Query - Flatten click_event data from Application Insights
// ============================================================================
// Purpose: Extract click_event rows with all known CustomProps fields as
//          flat columns (CP_* prefix). Designed to stay under the 65 MB
//          App Insights result-size cap by:
//            1. Filtering early (PageStatus, PageURL, time window).
//            2. Projecting only known columns (no mv-expand of unknown keys).
//            3. Forcing every CP_* value to string (predictable types).
//
// Output: One row per click event. Columns:
//   timestamp [UTC] (formatted to microsecond precision for CSV export)
//   name, user_Id, session_Id, client_CountryOrRegion
//   CP_<Field> for every documented CustomProps key
//
// Filters applied to the main query:
//   - name == "click_event"
//   - PageStatus == "Published"  (drafts/archived excluded)
//   - PageURL contains UrlPattern (set "" to disable)
//   - Time range is taken from the App Insights UI time picker
//     (no `where timestamp` clause in the query — the UI injects it).
//
// CHUNKING (when 65 MB result cap is hit):
//   Use the UI time-range picker to narrow the window (e.g. 7 days at a
//   time) and re-run; concatenate the resulting CSVs.
//
// HOW TO USE: Copy from "set truncationmaxrecords" to "order by".
// ============================================================================


// === COPY FROM HERE ===
set truncationmaxrecords = 500000;
let UrlPattern = "";  // empty = match all pages
customEvents
| where name == "click_event"
| extend CP = todynamic(tostring(todynamic(customDimensions).CustomProps))
| where tostring(CP.PageStatus) == "Published"
| where UrlPattern == "" or tostring(CP.PageURL) contains UrlPattern
| project
    ['timestamp [UTC]']     = format_datetime(timestamp, 'dd/MM/yyyy HH:mm:ss.fffffff'),
    name,
    user_Id,
    session_Id,
    client_CountryOrRegion,
    CP_SiteID               = tostring(CP.SiteID),
    CP_SiteName             = tostring(CP.SiteName),
    CP_PageId               = tostring(CP.PageId),
    CP_PageName             = tostring(CP.PageName),
    CP_PageURL              = tostring(CP.PageURL),
    CP_PageStatus           = tostring(CP.PageStatus),
    CP_ContentType          = tostring(CP.ContentType),
    CP_ContentOwner         = tostring(CP.ContentOwner),
    CP_ComponentName        = tostring(CP.ComponentName),
    CP_GPN                  = tostring(CP.GPN),
    CP_Email                = tostring(CP.Email),
    CP_Link_Type            = tostring(CP.Link_Type),
    CP_Link_label           = tostring(CP.Link_label),
    CP_Link_address         = tostring(CP.Link_address),
    CP_Link_ancestors       = tostring(CP.Link_ancestors),
    CP_FileType_Label       = tostring(CP.FileType_Label),
    CP_FileName_Label       = tostring(CP.FileName_Label),
    CP_NewsCategory         = tostring(CP.NewsCategory),
    CP_PublishingDate       = tostring(CP.PublishingDate),
    CP_Topic                = tostring(CP.Topic),
    CP_Theme                = tostring(CP.Theme),
    CP_TargetOrg            = tostring(CP.TargetOrg),
    CP_TargetRegion         = tostring(CP.TargetRegion),
    CP_mfLst                = tostring(CP.mfLst),
    CP_Video_Action         = tostring(CP.Video_Action),
    CP_Video_Id             = tostring(CP.Video_Id),
    CP_Video_Title          = tostring(CP.Video_Title),
    CP_Video_Type           = tostring(CP.Video_Type),
    CP_Video_Duration       = tostring(CP.Video_Duration),
    CP_Video_PlayedTime     = tostring(CP.Video_PlayedTime),
    CP_Video_Address        = tostring(CP.Video_Address)
| order by ['timestamp [UTC]'] desc
// === COPY TO HERE ===


// ============================================================================
// ALTERNATIVE QUERIES (copy/paste separately)
// ============================================================================

// --- QUERY A: Key discovery ---
// Find every CustomProps key currently in use and its hit count. Use to
// detect new fields that should be added to the projection above.
// Time range comes from the App Insights UI time picker.
//
// customEvents
// | where name == "click_event"
// | extend CP = todynamic(tostring(todynamic(customDimensions).CustomProps))
// | mv-expand cpKey = bag_keys(CP) to typeof(string)
// | summarize KeyCount = count(), SampleValue = take_any(tostring(CP[cpKey])) by Key = cpKey
// | order by KeyCount desc


// --- QUERY C: Anonymized extraction (hash GPN, drop Email) ---
// Same shape as the main query, but GPN is HMAC-SHA256-hashed with a
// pepper and CP_Email is replaced with empty string. Drop the resulting
// CSV into input/ and process_clicks.py picks it up unchanged.
// Time range comes from the App Insights UI time picker.
set truncationmaxrecords = 500000;
let UrlPattern = "";
let pepper     = "f4c6a28e86cfa11e95ee832cabf4c8c1862f78017c044111cae083584f0208cb";
customEvents
| where name == "click_event"
| extend CP = todynamic(tostring(todynamic(customDimensions).CustomProps))
| where tostring(CP.PageStatus) == "Published"
| where UrlPattern == "" or tostring(CP.PageURL) contains UrlPattern
| project
    ['timestamp [UTC]']     = format_datetime(timestamp, 'dd/MM/yyyy HH:mm:ss.fffffff'),
    name,
    user_Id,
    session_Id,
    client_CountryOrRegion,
    CP_SiteID               = tostring(CP.SiteID),
    CP_SiteName             = tostring(CP.SiteName),
    CP_PageId               = tostring(CP.PageId),
    CP_PageName             = tostring(CP.PageName),
    CP_PageURL              = tostring(CP.PageURL),
    CP_PageStatus           = tostring(CP.PageStatus),
    CP_ContentType          = tostring(CP.ContentType),
    CP_ContentOwner         = tostring(CP.ContentOwner),
    CP_ComponentName        = tostring(CP.ComponentName),
    CP_GPN                  = hash_sha256(strcat(pepper, tostring(CP.GPN))),
    CP_Email                = "",
    CP_Link_Type            = tostring(CP.Link_Type),
    CP_Link_label           = tostring(CP.Link_label),
    CP_Link_address         = tostring(CP.Link_address),
    CP_Link_ancestors       = tostring(CP.Link_ancestors),
    CP_FileType_Label       = tostring(CP.FileType_Label),
    CP_FileName_Label       = tostring(CP.FileName_Label),
    CP_NewsCategory         = tostring(CP.NewsCategory),
    CP_PublishingDate       = tostring(CP.PublishingDate),
    CP_Topic                = tostring(CP.Topic),
    CP_Theme                = tostring(CP.Theme),
    CP_TargetOrg            = tostring(CP.TargetOrg),
    CP_TargetRegion         = tostring(CP.TargetRegion),
    CP_mfLst                = tostring(CP.mfLst),
    CP_Video_Action         = tostring(CP.Video_Action),
    CP_Video_Id             = tostring(CP.Video_Id),
    CP_Video_Title          = tostring(CP.Video_Title),
    CP_Video_Type           = tostring(CP.Video_Type),
    CP_Video_Duration       = tostring(CP.Video_Duration),
    CP_Video_PlayedTime     = tostring(CP.Video_PlayedTime),
    CP_Video_Address        = tostring(CP.Video_Address)
| order by ['timestamp [UTC]'] desc


// --- QUERY D: Filter by specific email (change EmailFilter value) ---
// NOTE: Uses plain-text GPN/Email for filtering — not anonymized.
// Time range comes from the App Insights UI time picker.
set truncationmaxrecords = 500000;
let UrlPattern  = "";
let EmailFilter = "john.doe";
customEvents
| where name == "click_event"
| extend CP = todynamic(tostring(todynamic(customDimensions).CustomProps))
| where tostring(CP.PageStatus) == "Published"
| where UrlPattern == "" or tostring(CP.PageURL) contains UrlPattern
| where tostring(CP.Email) contains EmailFilter
| project
    ['timestamp [UTC]']     = format_datetime(timestamp, 'dd/MM/yyyy HH:mm:ss.fffffff'),
    name,
    user_Id,
    session_Id,
    client_CountryOrRegion,
    CP_SiteID               = tostring(CP.SiteID),
    CP_SiteName             = tostring(CP.SiteName),
    CP_PageId               = tostring(CP.PageId),
    CP_PageName             = tostring(CP.PageName),
    CP_PageURL              = tostring(CP.PageURL),
    CP_PageStatus           = tostring(CP.PageStatus),
    CP_ContentType          = tostring(CP.ContentType),
    CP_ContentOwner         = tostring(CP.ContentOwner),
    CP_ComponentName        = tostring(CP.ComponentName),
    CP_GPN                  = tostring(CP.GPN),
    CP_Email                = tostring(CP.Email),
    CP_Link_Type            = tostring(CP.Link_Type),
    CP_Link_label           = tostring(CP.Link_label),
    CP_Link_address         = tostring(CP.Link_address),
    CP_Link_ancestors       = tostring(CP.Link_ancestors),
    CP_FileType_Label       = tostring(CP.FileType_Label),
    CP_FileName_Label       = tostring(CP.FileName_Label),
    CP_NewsCategory         = tostring(CP.NewsCategory),
    CP_PublishingDate       = tostring(CP.PublishingDate),
    CP_Topic                = tostring(CP.Topic),
    CP_Theme                = tostring(CP.Theme),
    CP_TargetOrg            = tostring(CP.TargetOrg),
    CP_TargetRegion         = tostring(CP.TargetRegion),
    CP_mfLst                = tostring(CP.mfLst),
    CP_Video_Action         = tostring(CP.Video_Action),
    CP_Video_Id             = tostring(CP.Video_Id),
    CP_Video_Title          = tostring(CP.Video_Title),
    CP_Video_Type           = tostring(CP.Video_Type),
    CP_Video_Duration       = tostring(CP.Video_Duration),
    CP_Video_PlayedTime     = tostring(CP.Video_PlayedTime),
    CP_Video_Address        = tostring(CP.Video_Address)
| order by ['timestamp [UTC]'] desc


// --- QUERY E: Filter by target link / URL (change LinkFilter value) ---
// Extract clicks whose DESTINATION url matches LinkFilter, regardless of
// which page the click came from. Matches against CP.Link_address (the
// clicked link's target) with a case-insensitive substring `contains`.
// No PageURL filter here — set LinkFilter to a fragment of the target link.
// Time range comes from the App Insights UI time picker.
set truncationmaxrecords = 500000;
let LinkFilter = "we-are-ubs";  // substring of the target link; "" = all
customEvents
| where name == "click_event"
| extend CP = todynamic(tostring(todynamic(customDimensions).CustomProps))
| where tostring(CP.PageStatus) == "Published"
| where LinkFilter == "" or tostring(CP.Link_address) contains LinkFilter
| project
    ['timestamp [UTC]']     = format_datetime(timestamp, 'dd/MM/yyyy HH:mm:ss.fffffff'),
    name,
    user_Id,
    session_Id,
    client_CountryOrRegion,
    CP_SiteID               = tostring(CP.SiteID),
    CP_SiteName             = tostring(CP.SiteName),
    CP_PageId               = tostring(CP.PageId),
    CP_PageName             = tostring(CP.PageName),
    CP_PageURL              = tostring(CP.PageURL),
    CP_PageStatus           = tostring(CP.PageStatus),
    CP_ContentType          = tostring(CP.ContentType),
    CP_ContentOwner         = tostring(CP.ContentOwner),
    CP_ComponentName        = tostring(CP.ComponentName),
    CP_GPN                  = tostring(CP.GPN),
    CP_Email                = tostring(CP.Email),
    CP_Link_Type            = tostring(CP.Link_Type),
    CP_Link_label           = tostring(CP.Link_label),
    CP_Link_address         = tostring(CP.Link_address),
    CP_Link_ancestors       = tostring(CP.Link_ancestors),
    CP_FileType_Label       = tostring(CP.FileType_Label),
    CP_FileName_Label       = tostring(CP.FileName_Label),
    CP_NewsCategory         = tostring(CP.NewsCategory),
    CP_PublishingDate       = tostring(CP.PublishingDate),
    CP_Topic                = tostring(CP.Topic),
    CP_Theme                = tostring(CP.Theme),
    CP_TargetOrg            = tostring(CP.TargetOrg),
    CP_TargetRegion         = tostring(CP.TargetRegion),
    CP_mfLst                = tostring(CP.mfLst),
    CP_Video_Action         = tostring(CP.Video_Action),
    CP_Video_Id             = tostring(CP.Video_Id),
    CP_Video_Title          = tostring(CP.Video_Title),
    CP_Video_Type           = tostring(CP.Video_Type),
    CP_Video_Duration       = tostring(CP.Video_Duration),
    CP_Video_PlayedTime     = tostring(CP.Video_PlayedTime),
    CP_Video_Address        = tostring(CP.Video_Address)
| order by ['timestamp [UTC]'] desc


// --- QUERY F: Source pages driving clicks to a target link ---
// One row per source PageURL: how many clicks went from that page to a
// link whose target matches LinkFilter. Answers "which pages send traffic
// to <target>?". Sorted by click volume.
//   Clicks      = number of clicks from this page to a matching target
//   UniqueUsers = distinct users who made those clicks
//   Targets     = number of DISTINCT matching target URLs clicked from this page
// Time range comes from the App Insights UI time picker.
set truncationmaxrecords = 500000;
let LinkFilter = "we-are-ubs";  // substring of the target link
customEvents
| where name == "click_event"
| extend CP = todynamic(tostring(todynamic(customDimensions).CustomProps))
| where tostring(CP.PageStatus) == "Published"
| where tostring(CP.Link_address) contains LinkFilter
| summarize
    Clicks      = count(),
    UniqueUsers = dcount(user_Id),
    Targets     = dcount(tostring(CP.Link_address))
    by
    PageURL     = tostring(CP.PageURL),
    PageName    = tostring(CP.PageName)
| order by Clicks desc


// --- QUERY G: Source page -> target link pairs ---
// One row per (source PageURL, target URL) pair for links matching
// LinkFilter. Finer than QUERY F: shows exactly which target was clicked
// from which page. Sorted by click volume.
// Time range comes from the App Insights UI time picker.
set truncationmaxrecords = 500000;
let LinkFilter = "we-are-ubs";  // substring of the target link
customEvents
| where name == "click_event"
| extend CP = todynamic(tostring(todynamic(customDimensions).CustomProps))
| where tostring(CP.PageStatus) == "Published"
| where tostring(CP.Link_address) contains LinkFilter
| summarize
    Clicks      = count(),
    UniqueUsers = dcount(user_Id)
    by
    PageURL     = tostring(CP.PageURL),
    TargetURL   = tostring(CP.Link_address)
| order by Clicks desc
